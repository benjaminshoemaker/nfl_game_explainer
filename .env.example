# NFL Game Explainer Environment Variables

# OpenAI API Key (optional - enables AI summaries)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5.6-luna

# Optional production-only, opt-in visitor analytics (public project token)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
# Explicit local QA only; these events are marked is_test and excluded from reports
ANALYTICS_TEST_MODE=0

# Vercel-specific (auto-set by Vercel)
# VERCEL_URL=your-deployment.vercel.app
